BOTCHAIN_RPC_URL=https://rpc.bohr.life
BOTCHAIN_CHAIN_ID=968
BOTCHAIN_EXPLORER_URL=https://scan.bohr.life
BOTCHAIN_VERIFIER_URL=https://scan.bohr.life/api
# Server-side secrets only. Never add a NEXT_PUBLIC_ prefix.
DEPLOYER_PRIVATE_KEY=
BLOCKSCOUT_API_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Enable on an HTTPS deployment; keep false for localhost.
AUTH_COOKIE_SECURE=false
