# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Enable on an HTTPS deployment; keep false for localhost.
AUTH_COOKIE_SECURE=false
# Optional canonical origin behind an HTTPS reverse proxy.
APP_ORIGIN=
